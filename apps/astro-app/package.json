{
	"name": "unseal-astro",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun ./node_modules/astro/bin/astro.mjs dev",
		"build": "bun ./node_modules/astro/bin/astro.mjs build",
		"test": "vitest run",
		"preview": "bun ./dist/server/entry.mjs",
		"start:prod": "bun ./dist/server/entry.mjs",
		"test:runtime": "bun ./scripts/smoke.mjs",
		"astro": "bun ./node_modules/astro/bin/astro.mjs",
		"check-types": "bun ./node_modules/astro/bin/astro.mjs sync && tsc --noEmit",
		"lint": "biome check --write"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.7",
		"@astrojs/react": "^7.0.1",
		"@astrojs/sitemap": "^3.7.4",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/openapi": "^1.4.16",
		"@nanostores/react": "^2.0.1",
		"@repo/custom-effects": "workspace:*",
		"@repo/types": "workspace:*",
		"@repo/ui": "workspace:*",
		"@sinclair/typebox": "^0.34.52",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.8",
		"effect": "^4.0.4",
		"elysia": "^1.4.30",
		"lucide-react": "^1.56.0",
		"nanostores": "^1.5.5",
		"openapi-types": "^12.1.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"posthog-js": "^1.438.9",
		"vitest": "^5.0.4"
	}
